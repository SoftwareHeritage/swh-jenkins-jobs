stage('Apply dependent merge requests or commits on required swh packages') {
  when {
    expression { return dependentRefs }
  }
  steps {
    script {
      // list requirements-* files
      def requirementsFiles = sh(
        script: "ls requirements-*.txt tox.ini",
        returnStdout: true
      ).trim().split("\n")
      // iterate on requirements files
      for (requirementFile in requirementsFiles) {
        def requirement = sh(
          script: "cat $requirementFile",
          returnStdout: true
        ).trim()
        // iterate on merge requests to apply
        for (dependentRef in dependentRefs) {
          def packageName = dependentRef[0]
          def packageNameDot = packageName.replace("-", ".")
          def refId = dependentRef[1]
          if ((requirement =~ /(?m)^[ ]*${packageNameDot}/).count) {
            // if a requirement file contain a package with a merge request to apply
            def swhPackage = packageNameDot
            def extraMatch = requirement =~ /(?m)^[ ]*${packageNameDot}(\[[^\]]+\])/
            if (extraMatch.count) {
              // get extra deps for the package
              swhPackage += extraMatch[0][1]
              packageNameDot += extraMatch[0][1].replace("[", "\\[").replace("]", "\\]")
            }
            // need to reset Matcher or jenkins will try to serialize it when leaving scope and crash
            extraMatch = null
            def refUrl
            if ((refId =~ /^[0-9]+$/).count) {
              // ref is a merge request
              refUrl = "git\\+https://gitlab.softwareheritage.org/swh/devel/${packageName}.git@refs/merge-requests/$refId/head"
            } else {
              // ref is a commit
              refUrl = "git\\+https://gitlab.softwareheritage.org/swh/devel/${packageName}.git@$refId"
            }
            // replace package requirement to target merge request changes
            sh "sed -i 's+^\\([ ]*\\)${packageNameDot}[ *<>=!0-9\\.]*\$+\\1${swhPackage}@${refUrl}+' $requirementFile"
          }
        }
        sh "cat $requirementFile"
      }
      // update hatchling configuration so packages are allowed to be fetched from git
      sh """#!/bin/bash
      if [ -f pyproject.toml ]; then
          pip install toml-cli
          toml set --toml-path pyproject.toml --to-bool tool.hatch.metadata.allow-direct-references true
      fi
      """
    }
  }
}
